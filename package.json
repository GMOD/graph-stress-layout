{
  "name": "@jbrowse/graph-stress-layout",
  "version": "0.1.1",
  "description": "Sequence graph layout in plain JS: a reference backbone drawn straight with every variant placed against it, walk-guided stress SGD for components without one, a polyline per node out",
  "license": "MIT",
  "author": {
    "name": "Colin Diesh",
    "email": "colin.diesh@gmail.com",
    "url": "https://github.com/cmdcolin"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/graph-stress-layout.git"
  },
  "keywords": [
    "pangenome",
    "graph",
    "layout",
    "stress"
  ],
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      }
    }
  },
  "files": [
    "esm"
  ],
  "scripts": {
    "build": "rm -rf esm && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepack": "pnpm build",
    "preversion": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "postversion": "git push --follow-tags"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
